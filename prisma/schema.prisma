// Prisma Schema File

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =======================
// ENUMS
// =======================

enum UserRole {
  USER
  ADMIN
  OWNER
  SUPERADMIN
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum NotificationType {
  RESERVATION_CONFIRMED
  RESERVATION_CANCELLED
  RESERVATION_REMINDER
  PROMOTION
  GENERAL
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  CANCELLED
}

enum MessageRole {
  USER
  ASSISTANT
}

// =======================
// MODELS
// =======================

model Tenant {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  salons Salon[]
  users  User[]
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String
  role     UserRole @default(USER)

  tenantId Int?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  salons        Salon[]
  reservations  Reservation[]
  reviews       Review[]
  notifications Notification[]
  invoices      Invoice[]
  giftCards     GiftCard[]
  auditLogs     AuditLog[]
  chatSessions  ChatSession[]
  waitlist      Waitlist[]

  createdAt DateTime @default(now())

  @@index([tenantId])
}

model Salon {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  city        String

  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id])

  tenantId Int?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  categories   Category[]
  services     Service[]
  employees    Employee[]
  reservations Reservation[]
  reviews      Review[]
  invoices     Invoice[]
  promotions   Promotion[]
  giftCards    GiftCard[]
  products     Product[]
  waitlist     Waitlist[]

  createdAt DateTime @default(now())

  @@index([tenantId])
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  salonId     Int
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  services    Service[]
  createdAt   DateTime @default(now())

  @@index([salonId])
}

model Service {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  duration    Int
  price       Float

  salonId Int
  salon   Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  employees    EmployeeService[]
  reservations Reservation[]
  waitlist     Waitlist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salonId])
}

model Employee {
  id    Int     @id @default(autoincrement())
  name  String
  email String  @unique
  phone String?

  salonId Int
  salon   Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  services     EmployeeService[]
  workingHours WorkingHour[]
  reservations Reservation[]
  reviews      Review[]
  waitlist     Waitlist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salonId])
}

model EmployeeService {
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  serviceId  Int
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([employeeId, serviceId])
}

model WorkingHour {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  startTime  String
  endTime    String
  salonId    Int

  @@unique([employeeId, dayOfWeek])
}

model Reservation {
  id         Int               @id @default(autoincrement())
  salonId    Int
  salon      Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customerId Int
  customer   User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  employeeId Int
  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  serviceId  Int
  service    Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  date      DateTime
  startTime String
  endTime   String
  status    ReservationStatus @default(PENDING)

  review  Review?
  invoice Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, date])
  @@index([salonId])
}

model Review {
  id      Int    @id @default(autoincrement())
  rating  Int
  comment String?

  customerId Int
  customer   User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  salonId Int
  salon   Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  employeeId Int?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  reservationId Int         @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([salonId])
}

model Notification {
  id      Int              @id @default(autoincrement())
  userId  Int
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title   String
  message String
  isRead  Boolean          @default(false)
  type    NotificationType @default(GENERAL)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Invoice {
  id            Int           @id @default(autoincrement())
  reservationId Int           @unique
  reservation   Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  customerId    Int
  customer      User          @relation(fields: [customerId], references: [id])
  salonId       Int
  salon         Salon         @relation(fields: [salonId], references: [id])
  totalAmount   Float
  status        InvoiceStatus @default(PENDING)
  payment       Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salonId])
  @@index([customerId])
}

model Payment {
  id        Int           @id @default(autoincrement())
  invoiceId Int           @unique
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method    PaymentMethod @default(CASH)
  amount    Float
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?

  createdAt DateTime @default(now())
}

model Promotion {
  id            Int          @id @default(autoincrement())
  salonId       Int
  salon         Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  discountType  DiscountType
  discountValue Float
  code          String?      @unique
  validFrom     DateTime
  validTo       DateTime
  isActive      Boolean      @default(true)

  createdAt DateTime @default(now())

  @@index([salonId])
}

model GiftCard {
  id             Int       @id @default(autoincrement())
  salonId        Int
  salon          Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  code           String    @unique
  value          Float
  remainingValue Float
  issuedToId     Int?
  issuedTo       User?     @relation(fields: [issuedToId], references: [id], onDelete: SetNull)
  usedAt         DateTime?
  expiresAt      DateTime?

  createdAt DateTime @default(now())

  @@index([salonId])
}

model Product {
  id          Int     @id @default(autoincrement())
  salonId     Int
  salon       Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float
  stock       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salonId])
}

model AuditLog {
  id       Int     @id @default(autoincrement())
  userId   Int?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  action   String
  entity   String
  entityId Int?
  details  Json?

  createdAt DateTime @default(now())

  @@index([userId])
}

model ChatSession {
  id    Int     @id @default(autoincrement())
  userId Int
  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String?

  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ChatMessage {
  id        Int         @id @default(autoincrement())
  sessionId Int
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String

  createdAt DateTime @default(now())

  @@index([sessionId])
}

model Waitlist {
  id         Int            @id @default(autoincrement())
  customerId Int
  customer   User           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salonId    Int
  salon      Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  employeeId Int
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  serviceId  Int
  service    Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  date       DateTime
  status     WaitlistStatus @default(WAITING)

  createdAt DateTime @default(now())

  @@index([salonId])
  @@index([customerId])
}
