// Prisma Schema File

generator client {
  provider = "prisma-client-js"
   
}

datasource db {
  provider = "postgresql"
url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  OWNER
  SUPERADMIN
}

model Tenant {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  salons    Salon[]
  users     User[]
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(USER)

  tenantId  Int?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  salons       Salon[]
  reservations Reservation[]

  createdAt DateTime @default(now())

  @@index([tenantId])
}

model Salon {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  city        String

  ownerId     Int
  owner       User     @relation(fields: [ownerId], references: [id])

  tenantId    Int?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  services     Service[]
  employees    Employee[]
  reservations Reservation[]

  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model Service {
  id          Int               @id @default(autoincrement())
  name        String
  description String?
  duration    Int               // in minutes (e.g., 30, 60, 90)
  price       Float             // service price (e.g. 50.00)
  salonId     Int
  salon       Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  employees   EmployeeService[]
  reservations Reservation[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([salonId])
}

model Employee {
  id           Int               @id @default(autoincrement())
  name         String
  email        String            @unique
  phone        String?
  salonId      Int
  salon       Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  services     EmployeeService[]
  workingHours WorkingHour[]
  reservations Reservation[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([salonId])
}

// Explicit Join Table for Many-to-Many employee <-> service mapping
model EmployeeService {
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  serviceId  Int
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([employeeId, serviceId])
}

model WorkingHour {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      // 0 = Sunday, 1 = Monday, 2 = Tuesday, ..., 6 = Saturday
  startTime  String   // HH:MM format (24h clock, e.g. "09:00")
  endTime    String   // HH:MM format (24h clock, e.g. "17:00")
  salonId    Int      // Redundant cached field for fast multi-tenancy verification

  @@unique([employeeId, dayOfWeek]) // Prevent multiple schedules on the same day for an employee
}

model Reservation {
  id          Int               @id @default(autoincrement())
  salonId     Int
  salon       Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customerId  Int
  customer    User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  employeeId  Int
  employee    Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  serviceId   Int
  service     Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  
  date        DateTime          // Date of reservation (normalized to midnight UTC)
  startTime   String            // HH:MM format (e.g. "10:00")
  endTime     String            // HH:MM format (Calculated dynamically: startTime + service.duration)
  status      ReservationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([employeeId, date])
  @@index([salonId])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}